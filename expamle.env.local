# 1. Koneksi Database MongoDB
# Pastikan MongoDB lokal sudah berjalan. 'nilai_siswa' adalah nama databasenya.
MONGODB_URI=mongodb://localhost:27017/nilai_siswa

# 2. Pengaturan NextAuth (Login)
# URL aplikasi kita saat berjalan di laptop
NEXTAUTH_URL=http://localhost:3000

# Kunci rahasia untuk enkripsi sesi login. 
# Di NextAuth v5 (Beta), disarankan menggunakan AUTH_SECRET, 
# tapi kita pasang NEXTAUTH_SECRET juga agar kompatibel dengan kode sebelumnya.
AUTH_SECRET=rahasia_super_aman
NEXTAUTH_SECRET=rahasia_super_aman

BACKUP_SECRET_KEY="rahasia_sekolah_ini_sangat_aman_123"

# PUSHER CONFIG (SERVER SIDE - Rahasia)
PUSHER_APP_ID="2096663"
PUSHER_SECRET="6c2a3c06fb66c4afcf09"

# PUSHER CONFIG (CLIENT SIDE - Bisa dibaca Browser)
# Kita tambahkan NEXT_PUBLIC_ di depannya
NEXT_PUBLIC_PUSHER_KEY="7385539f8386cf6c8096"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# Simpan juga versi tanpa prefix untuk server action (biar konsisten)
PUSHER_KEY="7385539f8386cf6c8096"
PUSHER_CLUSTER="ap1"

#cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dh851sals"
NEXT_PUBLIC_CLOUDINARY_PRESET="sekolah_upload"